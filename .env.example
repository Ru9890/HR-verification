# ResumeVerify AI Configuration

# Application settings
APP_NAME=ResumeVerify AI
DEBUG=True

# Database (Default SQLite, or PostgreSQL URL: postgresql+asyncpg://user:pass@localhost:5432/resumedb)
DATABASE_URL=sqlite+aiosqlite:///./resume_verify.db

# GitHub REST API Token (Optional, boosts rate limit from 60 to 5,000 req/hr)
# NEVER commit your real token to Git!
GITHUB_TOKEN=

# AI Provider Configuration (rule_based, openai, gemini, groq, ollama)
LLM_PROVIDER=rule_based

# Optional API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
